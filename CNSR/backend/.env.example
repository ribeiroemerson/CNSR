# PostgreSQL: ajuste usuário, senha, host e nome do banco
DATABASE_URL="postgresql://usuario:senha@localhost:5432/cnsr?schema=public"

# Segredo usado para assinar os tokens JWT dos administradores
JWT_SECRET="troque-por-um-segredo-forte-e-aleatorio"

PORT=3333

# "development" ou "production"
NODE_ENV=development

# Origem permitida para requisições CORS em produção (ex: https://seu-frontend.com)
# Deixe "*" apenas em desenvolvimento
CORS_ORIGIN=*

# E-mail do administrador principal (o primeiro a se cadastrar, sem convite).
# Depois dele, novos administradores só entram com token de convite gerado por ele.
ADMIN_PRINCIPAL_EMAIL=principal@prefeitura.exemplo.gov.br

# Envio de e-mails via Gmail (opcional). Use uma 'Senha de app' (conta Google com verificacao em 2 etapas),
# nunca a senha normal. Sem isso, o token/senha temporaria e exibido ao administrador principal.
GMAIL_USER=
GMAIL_APP_PASSWORD=
