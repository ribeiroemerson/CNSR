# PostgreSQL: ajuste usuário, senha, host e nome do banco
DATABASE_URL="postgresql://usuario:senha@localhost:5432/cnsr?schema=public"

# Segredo usado para assinar os tokens JWT dos administradores
JWT_SECRET="troque-por-um-segredo-forte-e-aleatorio"

PORT=3333

# "development" ou "production"
NODE_ENV=development

# Origem permitida para requisições CORS em produção (ex: https://seu-frontend.com)
# Deixe "*" apenas em desenvolvimento
CORS_ORIGIN=*
